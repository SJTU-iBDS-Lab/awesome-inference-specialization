  "alias_rule": "Terms are search variants and related targets, not assertions of identical architecture, model weights or hardware compatibility.",
  "query_templates": [
    {
      "id": "recent-engines",
      "surface": "github-repositories",
      "query": "\"inference\" \"engine\" created:>={since} archived:false",
      "group_id": "engine-identity"
    },
    {
      "id": "active-specialized",
      "surface": "github-repositories",
      "query": "\"specialized inference\" in:name,description,readme pushed:>={since} archived:false",
      "group_id": "engine-identity"
    },
    {
      "id": "agent-engines",
      "surface": "github-repositories",
      "query": "\"inference engine\" \"coding agents\" in:name,description,readme archived:false",
      "group_id": "system-synthesis"
    },
    {
      "id": "native-target",
      "surface": "github-repositories",
      "query": "\"{model}\" \"native\" in:name,description,readme archived:false",
      "group_id": "engine-identity"
    },
    {
      "id": "construct-target",
      "surface": "github-repositories",
      "query": "\"{model}\" \"harness\" in:name,description,readme archived:false",
      "group_id": "system-synthesis"
    },
    {
      "id": "mechanism-target",
      "surface": "github-repositories",
      "query": "\"{mechanism}\" \"{hardware}\" in:name,description,readme pushed:>={since} archived:false",
      "group_id": "execution-kernels"
    },
    {
      "id": "expert-cache",
      "surface": "github-repositories",
      "query": "\"inference\" \"expert cache\" in:name,description,readme pushed:>={since} archived:false",
      "group_id": "expert-residency"
    },
    {
      "id": "persistent",
      "surface": "github-repositories",
      "query": "\"inference\" \"persistent\" \"{hardware}\" in:name,description,readme archived:false",
      "group_id": "execution-kernels"
    },
    {
      "id": "megakernel",
      "surface": "github-repositories",
      "query": "\"inference\" \"megakernel\" in:name,description,readme pushed:>={since} archived:false",
      "group_id": "execution-kernels"
    },
    {
      "id": "state-contract",
      "surface": "github-repositories",
      "query": "\"{model}\" \"state rollback\" in:name,description,readme archived:false",
      "group_id": "state-and-context"
    },
    {
      "id": "validation-loop",
      "surface": "github-repositories",
      "query": "\"{seed}\" \"quality gate\" in:name,description,readme archived:false",
      "group_id": "validation"
    },
    {
      "id": "fork-delta",
      "surface": "github-repositories",
      "query": "\"inference\" \"{hardware}\" fork:only pushed:>={since}",
      "group_id": "engine-identity"
    },
    {
      "id": "npu",
      "surface": "github-repositories",
      "query": "\"inference\" \"{hardware}\" in:name,description,readme created:>={since} archived:false",
      "group_id": "serving-workloads"
    },
    {
      "id": "diffusion",
      "surface": "github-repositories",
      "query": "\"diffusion\" \"inference\" created:>={since} archived:false",
      "group_id": "other-model-domains"
    },
    {
      "id": "speech",
      "surface": "github-repositories",
      "query": "\"speech\" \"inference\" \"kernel\" in:name,description,readme created:>={since} archived:false",
      "group_id": "other-model-domains"
    },
    {
      "id": "exact-seed",
      "surface": "github-repositories",
      "query": "\"{seed}\" in:name,description,readme",
      "group_id": "engine-identity"
    },
    {
      "id": "web-engine",
      "surface": "web",
      "query": "site:github.com \"{model}\" \"{hardware}\" \"inference\"",
      "group_id": "engine-identity"
    },
    {
      "id": "web-construction",
      "surface": "web",
      "query": "\"{seed}\" \"engine\" \"synthesis\"",
      "group_id": "system-synthesis"
    },
    {
      "id": "web-lineage",
      "surface": "web",
      "query": "\"{seed}\" \"inspired by\" inference",
      "group_id": "expert-residency"
    },
    {
      "id": "web-author",
      "surface": "web",
      "query": "\"{seed}\" inference architecture benchmark source code",
      "group_id": "validation"
    }
  ],
  "source_routes": [
    {
      "id": "github",
      "url": "https://github.com/search?type=repositories",
      "use_cn": "名称／描述发现，README 扩展，分开搜索创建日期和推送日期；另做 fork:only。"
    },
    {
      "id": "first-party",
      "url": "https://github.com/skydiscover-ai/jitengine",
      "use_cn": "已收录仓库的致谢、NOTICE、VENDORED、对照基线和相关组织；回到被引用项目的官方仓库核查。"
    },
    {
      "id": "author-reports",
      "url": "https://skydiscover-ai.github.io/blog-jitengine.html",
      "use_cn": "作者博客／论文用于发现术语、产物与依赖；性能仍按原始比较条件记录。"
    },
    {
      "id": "topics",
      "url": "https://github.com/topics/inference-engine",
      "use_cn": "主题页仅作候选入口；星数、主题标签和搜索名次不是门槛。"
    }
  ],
  "screening_rules": [
    "Run a rolling pushed-date search and a separate created-date search; new to the catalog does not mean newly released.",
    "Keep an undated dependency/author search so older upstream work is not missed.",
    "Record exact query, surface, page and returned repository names; a capped sample is not exhaustive and unknown total counts stay unknown.",
    "Run at least one fork-only pass. Compare substantial execution deltas with the named parent before admission.",
    "Do not apply a stars threshold or globally exclude Python, MLX, wrappers, synthesis or speech. Inspect the delivered artifact.",
    "Normalize repository identity using canonical API full_name and repository ID; model packages, renamed repositories and workflow aliases are not automatically new records.",
    "Inspect implementation-to-kernel/state wiring and provenance; separate numerical/model changes from execution gains.",
    "Keep candidates outside projects.csv until the existing contribution/evidence requirements are met; no performance reproduction is implied."
  ]
}
